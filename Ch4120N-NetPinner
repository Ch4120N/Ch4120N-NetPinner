#!/usr/bin/env bash
#
# Ch4120N-NetPinner
#
# Make this machine's IPv4 address permanent on the current network without
# breaking other Wi-Fi / Ethernet networks.
#
# Supported backends:
#   - NetworkManager
#   - netplan
#   - systemd-networkd
#   - ifupdown
#   - Termux (Android, informational only)
#
# Usage:
#   sudo Ch4120N-NetPinner set           Interactive setup
#   sudo Ch4120N-NetPinner set --auto    Accept suggested defaults
#   sudo Ch4120N-NetPinner revert        Restore DHCP on current profile
#   sudo Ch4120N-NetPinner status        Show current IP / method / gateway
#   sudo Ch4120N-NetPinner list          List saved connection profiles
#   sudo Ch4120N-NetPinner help          Show help
#
# Flags:
#   --auto        Non-interactive, accept defaults
#   --quiet, -q   Disable spinner animation
#   --no-color    Disable ANSI colors
#
# Environment:
#   NO_COLOR=1           Disable colors (same as --no-color)
#   NETPINNER_QUIET=1    Disable spinner (same as --quiet)
#

set -euo pipefail

# Global state.
HAS_TTY=0
[ -t 1 ] && HAS_TTY=1

AUTO=0
QUIET="${NETPINNER_QUIET:-0}"
SPINNER_PID=""

# Colors, filled in by setup_colors.
R=; G=; Y=; B=; C=; M=; BOLD=; DIM=; N=

# Initialise the colour palette based on terminal capabilities.
setup_colors() {
  if [ "$HAS_TTY" -eq 1 ] && [ -z "${NO_COLOR:-}" ]; then
    R=$'\e[31m'; G=$'\e[32m'; Y=$'\e[33m'; B=$'\e[34m'
    C=$'\e[36m'; M=$'\e[35m'; BOLD=$'\e[1m'; DIM=$'\e[2m'; N=$'\e[0m'
  else
    R=; G=; Y=; B=; C=; M=; BOLD=; DIM=; N=
  fi
}
setup_colors

# Force colours off, used by the --no-color flag.
disable_colors() {
  R=; G=; Y=; B=; C=; M=; BOLD=; DIM=; N=
}

# Print an informational message.
log()  { printf '%s[*]%s %s\n' "$B" "$N" "$*"; }
# Print a success message.
ok()   { printf '%s[+]%s %s\n' "$G" "$N" "$*"; }
# Print a warning message.
warn() { printf '%s[!]%s %s\n' "$Y" "$N" "$*" >&2; }
# Print an error message.
err()  { printf '%s[-]%s %s\n' "$R" "$N" "$*" >&2; }
# Print an error and exit.
die()  { err "$*"; exit 1; }

# Stop a running spinner without printing anything.
spinner_cleanup() {
  if [ -n "${SPINNER_PID:-}" ] && kill -0 "$SPINNER_PID" 2>/dev/null; then
    kill "$SPINNER_PID" 2>/dev/null || true
    wait "$SPINNER_PID" 2>/dev/null || true
  fi
  SPINNER_PID=""
}
trap spinner_cleanup EXIT

# Start an animated spinner for a long-running task.
spinner_start() {
  local msg="$1"
  if [ "$HAS_TTY" -ne 1 ] || [ "$QUIET" = "1" ]; then
    printf '%s[*]%s %s\n' "$B" "$N" "$msg"
    return 0
  fi
  local chars='|/-\'
  (
    local i=0
    while :; do
      printf '\r%s[%s]%s %s' "$C" "${chars:$(( i++ % ${#chars} )):1}" "$N" "$msg"
      sleep 0.1
    done
  ) &
  SPINNER_PID=$!
}

# Stop the spinner and print a final line.
spinner_stop() {
  local final="${1:-}"
  spinner_cleanup
  if [ "$HAS_TTY" -eq 1 ] && [ "$QUIET" != "1" ]; then
    printf '\r\033[K'
  fi
  [ -n "$final" ] && printf '%s\n' "$final"
  return 0
}

# Run a command behind a spinner and report success or failure.
run_spin() {
  local msg="$1"; shift
  local logfile="${TMPDIR:-/tmp}/netpinner.$$.log"
  spinner_start "$msg"
  local rc=0
  "$@" >"$logfile" 2>&1 || rc=$?
  if [ "$rc" -eq 0 ]; then
    spinner_stop "$(printf '%s[+]%s %s' "$G" "$N" "$msg")"
  else
    spinner_stop "$(printf '%s[-]%s %s' "$R" "$N" "$msg")"
    [ -s "$logfile" ] && cat "$logfile" >&2
  fi
  rm -f "$logfile"
  return "$rc"
}

# Print a compact summary block.
print_summary() {
  local title="$1"; shift
  printf '\n%s%s%s\n' "$BOLD$M" "$title" "$N"
  local line
  for line in "$@"; do
    printf '  %s\n' "$line"
  done
  printf '\n'
}

# Type a string with a small per-character delay.
typewriter() {
  local text="$1" delay="${2:-0.012}"
  local i
  for (( i=0; i<${#text}; i++ )); do
    printf '%s' "${text:i:1}"
    sleep "$delay"
  done
  printf '\n'
}

# Print a small animated banner in interactive sessions.
show_banner() {
  [ "$HAS_TTY" -eq 1 ] || return 0
  [ "$QUIET" = "1" ] && return 0
  printf '\n%s' "$BOLD$M"
  typewriter "Ch4120N-NetPinner"
  printf '%s' "$N"
  printf '%sStatic IP helper for Linux and Termux%s\n\n' "$DIM" "$N"
}

# Show a countdown while waiting for the network to settle.
countdown() {
  local seconds="$1" msg="$2"
  if [ "$HAS_TTY" -ne 1 ] || [ "$QUIET" = "1" ]; then
    sleep "$seconds"
    return 0
  fi
  local i
  for (( i=seconds; i>0; i-- )); do
    printf '\r%s[*]%s %s %d' "$B" "$N" "$msg" "$i"
    sleep 1
  done
  printf '\r\033[K'
}

# Detect whether we are running inside Termux on Android.
is_termux() {
  [ -n "${TERMUX_VERSION:-}" ] && return 0
  case "${PREFIX:-}" in *com.termux*) return 0 ;; esac
  [ -d "/data/data/com.termux/files/usr" ] && return 0
  case "$(uname -o 2>/dev/null || true)" in Android*) return 0 ;; esac
  return 1
}

# Return true if systemctl exists.
has_systemctl() { command -v systemctl >/dev/null 2>&1; }

