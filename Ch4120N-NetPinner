#!/usr/bin/env bash
#
# Ch4120N-NetPinner
#
# Make this machine's IPv4 address permanent on the current network without
# breaking other Wi-Fi / Ethernet networks.
#
# Supported backends:
#   - NetworkManager
#   - netplan
#   - systemd-networkd
#   - ifupdown
#   - Termux (Android, informational only)
#
# Usage:
#   sudo Ch4120N-NetPinner set           Interactive setup
#   sudo Ch4120N-NetPinner set --auto    Accept suggested defaults
#   sudo Ch4120N-NetPinner revert        Restore DHCP on current profile
#   sudo Ch4120N-NetPinner status        Show current IP / method / gateway
#   sudo Ch4120N-NetPinner list          List saved connection profiles
#   sudo Ch4120N-NetPinner help          Show help
#
# Flags:
#   --auto        Non-interactive, accept defaults
#   --quiet, -q   Disable spinner animation
#   --no-color    Disable ANSI colors
#
# Environment:
#   NO_COLOR=1           Disable colors (same as --no-color)
#   NETPINNER_QUIET=1    Disable spinner (same as --quiet)
#

set -euo pipefail

# Global state.
HAS_TTY=0
[ -t 1 ] && HAS_TTY=1

AUTO=0
QUIET="${NETPINNER_QUIET:-0}"
SPINNER_PID=""

# Colors, filled in by setup_colors.
R=; G=; Y=; B=; C=; M=; BOLD=; DIM=; N=

# Initialise the colour palette based on terminal capabilities.
setup_colors() {
  if [ "$HAS_TTY" -eq 1 ] && [ -z "${NO_COLOR:-}" ]; then
    R=$'\e[31m'; G=$'\e[32m'; Y=$'\e[33m'; B=$'\e[34m'
    C=$'\e[36m'; M=$'\e[35m'; BOLD=$'\e[1m'; DIM=$'\e[2m'; N=$'\e[0m'
  else
    R=; G=; Y=; B=; C=; M=; BOLD=; DIM=; N=
  fi
}
setup_colors

# Force colours off, used by the --no-color flag.
disable_colors() {
  R=; G=; Y=; B=; C=; M=; BOLD=; DIM=; N=
}

# Print an informational message.
log()  { printf '%s[*]%s %s\n' "$B" "$N" "$*"; }
# Print a success message.
ok()   { printf '%s[+]%s %s\n' "$G" "$N" "$*"; }
# Print a warning message.
warn() { printf '%s[!]%s %s\n' "$Y" "$N" "$*" >&2; }
# Print an error message.
err()  { printf '%s[-]%s %s\n' "$R" "$N" "$*" >&2; }
# Print an error and exit.
die()  { err "$*"; exit 1; }

# Stop a running spinner without printing anything.
spinner_cleanup() {
  if [ -n "${SPINNER_PID:-}" ] && kill -0 "$SPINNER_PID" 2>/dev/null; then
    kill "$SPINNER_PID" 2>/dev/null || true
    wait "$SPINNER_PID" 2>/dev/null || true
  fi
  SPINNER_PID=""
}
trap spinner_cleanup EXIT

# Start an animated spinner for a long-running task.
spinner_start() {
  local msg="$1"
  if [ "$HAS_TTY" -ne 1 ] || [ "$QUIET" = "1" ]; then
    printf '%s[*]%s %s\n' "$B" "$N" "$msg"
    return 0
  fi
  local chars='|/-\'
  (
    local i=0
    while :; do
      printf '\r%s[%s]%s %s' "$C" "${chars:$(( i++ % ${#chars} )):1}" "$N" "$msg"
      sleep 0.1
    done
  ) &
  SPINNER_PID=$!
}

# Stop the spinner and print a final line.
spinner_stop() {
  local final="${1:-}"
  spinner_cleanup
  if [ "$HAS_TTY" -eq 1 ] && [ "$QUIET" != "1" ]; then
    printf '\r\033[K'
  fi
  [ -n "$final" ] && printf '%s\n' "$final"
  return 0
}

# Run a command behind a spinner and report success or failure.
run_spin() {
  local msg="$1"; shift
  local logfile="${TMPDIR:-/tmp}/netpinner.$$.log"
  spinner_start "$msg"
  local rc=0
  "$@" >"$logfile" 2>&1 || rc=$?
  if [ "$rc" -eq 0 ]; then
    spinner_stop "$(printf '%s[+]%s %s' "$G" "$N" "$msg")"
  else
    spinner_stop "$(printf '%s[-]%s %s' "$R" "$N" "$msg")"
    [ -s "$logfile" ] && cat "$logfile" >&2
  fi
  rm -f "$logfile"
  return "$rc"
}

# Print a compact summary block.
print_summary() {
  local title="$1"; shift
  printf '\n%s%s%s\n' "$BOLD$M" "$title" "$N"
  local line
  for line in "$@"; do
    printf '  %s\n' "$line"
  done
  printf '\n'
}

# Type a string with a small per-character delay.
typewriter() {
  local text="$1" delay="${2:-0.012}"
  local i
  for (( i=0; i<${#text}; i++ )); do
    printf '%s' "${text:i:1}"
    sleep "$delay"
  done
  printf '\n'
}

# Print a small animated banner in interactive sessions.
show_banner() {
  [ "$HAS_TTY" -eq 1 ] || return 0
  [ "$QUIET" = "1" ] && return 0
  printf '\n%s' "$BOLD$M"
  typewriter "Ch4120N-NetPinner"
  printf '%s' "$N"
  printf '%sStatic IP helper for Linux and Termux%s\n\n' "$DIM" "$N"
}

# Show a countdown while waiting for the network to settle.
countdown() {
  local seconds="$1" msg="$2"
  if [ "$HAS_TTY" -ne 1 ] || [ "$QUIET" = "1" ]; then
    sleep "$seconds"
    return 0
  fi
  local i
  for (( i=seconds; i>0; i-- )); do
    printf '\r%s[*]%s %s %d' "$B" "$N" "$msg" "$i"
    sleep 1
  done
  printf '\r\033[K'
}

# Detect whether we are running inside Termux on Android.
is_termux() {
  [ -n "${TERMUX_VERSION:-}" ] && return 0
  case "${PREFIX:-}" in *com.termux*) return 0 ;; esac
  [ -d "/data/data/com.termux/files/usr" ] && return 0
  case "$(uname -o 2>/dev/null || true)" in Android*) return 0 ;; esac
  return 1
}

# Return true if systemctl exists.
has_systemctl() { command -v systemctl >/dev/null 2>&1; }

# Abort unless the caller is root.
need_root() {
  [ "${EUID:-$(id -u)}" -eq 0 ] \
    || die "This command requires root. Try: sudo $0 ${1:-<command>}"
}

# Identify the active network backend.
detect_backend() {
  if is_termux; then
    echo termux
    return
  fi
  if command -v nmcli >/dev/null 2>&1 && \
     { { has_systemctl && systemctl is-active --quiet NetworkManager 2>/dev/null; } \
       || pgrep -x NetworkManager >/dev/null 2>&1; }; then
    echo networkmanager
  elif command -v netplan >/dev/null 2>&1 && [ -d /etc/netplan ]; then
    echo netplan
  elif has_systemctl && systemctl is-active --quiet systemd-networkd 2>/dev/null; then
    echo systemd-networkd
  elif [ -f /etc/network/interfaces ]; then
    echo ifupdown
  else
    echo unknown
  fi
}

# Return the interface carrying the default route.
active_iface() {
  if command -v ip >/dev/null 2>&1; then
    ip -o -4 route show default 2>/dev/null | awk '{print $5; exit}'
  fi
}

# Return IPv4 address with prefix length (e.g. 192.168.1.10/24).
iface_ipv4() {
  command -v ip >/dev/null 2>&1 \
    && ip -o -4 addr show dev "$1" 2>/dev/null | awk '{print $4; exit}'
}

# Return the bare IPv4 address of an interface.
iface_ip() { local x; x=$(iface_ipv4 "$1"); printf '%s' "${x%%/*}"; }

# Return the prefix length of an interface's IPv4 address.
iface_cidr() { local x; x=$(iface_ipv4 "$1"); printf '%s' "${x##*/}"; }

# Return the default gateway for an interface.
iface_gw() {
  command -v ip >/dev/null 2>&1 \
    && ip -4 route show default dev "$1" 2>/dev/null | awk '{print $3; exit}'
}

# Check whether an IPv4 address is already in use locally.
ip_in_use() {
  local ip="$1"
  ping -c1 -W1 "$ip" >/dev/null 2>&1 && return 0
  if command -v ip >/dev/null 2>&1; then
    ip neigh show "$ip" 2>/dev/null | grep -qE 'lladdr' && return 0
  fi
  return 1
}

# NetworkManager backend.

# Return the first active, non-virtual NetworkManager connection.
nm_active_line() {
  nmcli -t -f NAME,DEVICE,TYPE connection show --active 2>/dev/null \
    | grep -vE '^(docker|veth|br-|virbr)' | head -n1
}

# Print the current NetworkManager status.
nm_status() {
  log "Backend: NetworkManager"
  local line name dev type
  line=$(nm_active_line || true)
  if [ -z "${line:-}" ]; then
    warn "No active connection."
    return
  fi
  name=$(cut -d: -f1 <<<"$line")
  dev=$(cut -d: -f2 <<<"$line")
  type=$(cut -d: -f3 <<<"$line")
  printf '  Connection : %s\n' "$name"
  printf '  Device     : %s  (%s)\n' "$dev" "$type"
  printf '  IPv4       : %s\n' "$(iface_ipv4 "$dev" || echo none)"
  printf '  Gateway    : %s\n' "$(iface_gw  "$dev" || echo none)"
  printf '  Method     : %s\n' "$(nmcli -t -f ipv4.method connection show "$name" | cut -d: -f2)"
  printf '  DNS        : %s\n' "$(nmcli -t -f IP4.DNS connection show "$name" | cut -d: -f2 | paste -sd, -)"
}

# List NetworkManager connections.
nm_list() { nmcli -f NAME,DEVICE,TYPE,STATE connection show; }

# Apply a static configuration to a NetworkManager profile.
nm_set_static() {
  local conn="$1" addr="$2" prefix="$3" gw="$4" dns="$5"
  nmcli connection modify "$conn" \
    ipv4.method manual \
    ipv4.addresses "${addr}/${prefix}" \
    ipv4.gateway  "$gw" \
    ipv4.dns      "$dns"
  nmcli connection up "$conn" >/dev/null
}

# Return a NetworkManager profile to DHCP.
nm_revert() {
  local conn="$1"
  nmcli connection modify "$conn" \
    ipv4.method auto \
    ipv4.addresses "" \
    ipv4.gateway  "" \
    ipv4.dns      ""
  nmcli connection up "$conn" >/dev/null
}

# systemd-networkd backend.

# Locate the .network file that matches an interface.
snd_file_for() {
  grep -rls "^Name=$1\$" /etc/systemd/network/*.network 2>/dev/null | head -n1
}

# Apply a static configuration via systemd-networkd.
snd_set_static() {
  local iface="$1" addr="$2" prefix="$3" gw="$4" dns="$5"
  local f; f=$(snd_file_for "$iface")
  [ -n "$f" ] || f="/etc/systemd/network/20-${iface}.network"
  [ -f "$f" ] && cp -a "$f" "${f}.bak.$(date +%s)"
  cat > "$f" <<EOF
[Match]
Name=$iface

[Network]
DHCP=no
Address=${addr}/${prefix}
Gateway=$gw
$(printf 'DNS=%s\n' $(tr ',' ' ' <<<"$dns"))
EOF
  systemctl restart systemd-networkd
}

# Return a systemd-networkd interface to DHCP.
snd_revert() {
  local iface="$1"
  local f; f=$(snd_file_for "$iface") || true
  [ -n "$f" ] || die "No .network file found for $iface"
  cp -a "$f" "${f}.bak.$(date +%s)"
  cat > "$f" <<EOF
[Match]
Name=$iface

[Network]
DHCP=yes
